#!/bin/sh
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
mkdir -p /dev/pts /var/run /var/log /root /tmp /run
chmod 700 /root
chmod 1777 /tmp
mount -t devpts devpts /dev/pts || exit 1
echo HDD_BOOT_SELECTOR_USED > /run/request-status
# Keep SSH available for diagnosis even if request consumption fails.
/usr/local/sbin/mount-data > /var/log/alpine-data.log 2>&1
persistent_ready=1
/usr/local/sbin/persistent-settings > /var/log/persistent-settings.log 2>&1 || persistent_ready=0
/usr/local/sbin/phoenix-time restore > /var/log/clock-restore.log 2>&1
[ -s /etc/hostname ] && hostname -F /etc/hostname || hostname phoenix
ip link set lo up
ip link set eth0 up || exit 1
# DHCP must not hold the display/menu behind cable or router timeouts.
# Foreground client ownership in this background job retains lease renewal.
udhcpc -i eth0 -s /usr/local/sbin/phoenix-dhcp-event -p /var/run/udhcpc.eth0.pid -f -t 5 -T 3 > /var/log/udhcpc.log 2>&1 &
echo "BOOT_NETWORK_STARTED UPTIME=$(cut -d ' ' -f 1 /proc/uptime)"
/usr/sbin/dropbear -E -j -k -l eth0 -p 22 -r /etc/dropbear/dropbear_ed25519_host_key > /var/log/dropbear.log 2>&1
ip -4 addr show dev eth0
/usr/local/sbin/update-motd || :
echo ALPINE_NETWORK_STARTUP_FINISHED
[ "$persistent_ready" = 1 ] || { echo PERSISTENT_SETTINGS_FAILED; exit 1; }

/usr/local/sbin/nexus-display-autostart > /var/log/nexus-display-startup.log 2>&1 &

# Wi-Fi (only when set up and on): waits for the display server, then loads the stock driver.
/usr/local/sbin/phoenix-wifi daemon >> /var/log/wifi.log 2>&1 &

/usr/local/sbin/network-time-start > /var/log/network-time.log 2>&1 &




/usr/local/sbin/pvr-autostart > /var/log/pvr-start.log 2>&1 &
/usr/local/sbin/ui-autostart > /var/log/ui-autostart.log 2>&1 &
