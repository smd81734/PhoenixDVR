#!/bin/sh
set -eu
stop_one() {
 state="$1"
 expected="$2"
 [ -f "$state" ] || return 0
 pid=$(cat "$state")
 case "$pid" in ''|*[!0-9]*) echo 'Invalid PID file'; return 1;; esac
 [ "$pid" -gt 1 ] || return 1
 if [ ! -d "/proc/$pid" ]; then rm -f "$state"; return 0; fi
 tr '\000' '\n' < "/proc/$pid/cmdline" | grep -F -x "$expected" >/dev/null || { echo 'PID identity mismatch; not signalling'; return 1; }
 kill -TERM "$pid" || return 1
 n=0
 while kill -0 "$pid" 2>/dev/null; do
  n=$((n+1))
  [ "$n" -lt 15 ] || { echo 'Display process did not stop; reboot cancelled'; return 1; }
  sleep 1
 done
 rm -f "$state"
}
stop_one /run/nexus-display.pid /usr/local/bin/nxserver/nxserver
echo STOPPED > /run/nexus-display-status
echo NEXUS_DISPLAY_SERVER_STOPPED
