#!/bin/sh
# Foreground child ownership: wait records exit status, including signals.
set -u
cd /
mkdir /run/tvh-supervisor.lock 2>/dev/null || exit 1
echo $$ > /run/tvh-supervisor.pid
child=
xmltv=
finish() {
 trap '' TERM INT HUP
 touch /run/tvheadend-stop-request
 if [ -n "$xmltv" ]; then kill -TERM "$xmltv" 2>/dev/null || :; wait "$xmltv" 2>/dev/null || :; xmltv=; fi
 if [ -n "$child" ]; then kill -TERM "$child" 2>/dev/null || :; wait "$child" 2>/dev/null || :; fi
 rm -f /run/tvh-supervisor.pid /run/tvheadend.pid
 rmdir /run/tvh-supervisor.lock
}
trap 'finish; exit 0' TERM INT HUP
failures=0
while [ ! -e /run/tvheadend-stop-request ] && [ ! -e /run/nexus-tuner-shutdown ]; do
 [ "$(cat /run/alpine-data-status 2>/dev/null)" = DATA_MOUNTED_RW ] || break
 [ ! -e /mnt/recording-disk/phoenix-pvr/settings/disable-tvh-autostart ] || break
 /usr/local/sbin/recording-disk start >/dev/null || break
 [ -d /mnt/recording-disk/phoenix-pvr/tvheadend/config/accesscontrol ] || break
 /usr/local/sbin/tvheadend-lan >> /var/log/tvheadend-lan.log 2>&1 || break
 [ ! -f /mnt/recording-disk/phoenix-pvr/diagnostics/tvh/service.log ] || mv /mnt/recording-disk/phoenix-pvr/diagnostics/tvh/service.log /mnt/recording-disk/phoenix-pvr/diagnostics/tvh/service.previous.log
 start=$(cut -d . -f 1 /proc/uptime)
 /usr/bin/tvheadend -c /mnt/recording-disk/phoenix-pvr/tvheadend/config -u root -g root -b 0.0.0.0 --http_port 9981 --htsp_port 9982 -a -1 --nosatipcli -S </dev/null > /mnt/recording-disk/phoenix-pvr/diagnostics/tvh/service.log 2>&1 &
 child=$!
 echo "$child" > /run/tvheadend.pid
 echo RUNNING > /run/tvheadend-status
 /usr/bin/python3 -B /data/native-frontend/xmltv.py </dev/null >> /var/log/xmltv.log 2>&1 &
 xmltv=$!
 # Cover a lease arriving between the offline update and process launch.
 (sleep 3; /usr/local/sbin/tvheadend-lan --live >> /var/log/tvheadend-lan.log 2>&1) &
 wait "$child"
 result=$?
 kill -TERM "$xmltv" 2>/dev/null || :
 wait "$xmltv" 2>/dev/null || :
 xmltv=
 child=
 rm -f /run/tvheadend.pid
 [ ! -e /run/tvheadend-stop-request ] && [ ! -e /run/nexus-tuner-shutdown ] || break
 elapsed=$(( $(cut -d . -f 1 /proc/uptime) - start ))
 # Bounded rotating evidence: three log/dmesg slots, no unrestricted cores.
 [ "$elapsed" -lt 600 ] || failures=0
 failures=$((failures+1))
 out=/mnt/recording-disk/phoenix-pvr/diagnostics/tvh-supervised
 mkdir -p "$out"
 chmod 700 "$out"
 slot=$(( (failures-1) % 3 + 1 ))
 cp /mnt/recording-disk/phoenix-pvr/diagnostics/tvh/service.log "$out/exit-$slot.log"
 dmesg | tail -n 120 > "$out/exit-$slot.dmesg"
 printf 'UTC=%s EXIT=%s UPTIME=%s SHORT_FAILURES=%s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$result" "$elapsed" "$failures" > "$out/exit-$slot.status"
 if [ "$failures" -ge 3 ]; then
  echo RESTART_LIMIT_REACHED > /run/tvheadend-status
  finish
  exit 1
 fi
 echo RESTART_BACKOFF > /run/tvheadend-status
 delay=$((failures*10))
 while [ "$delay" -gt 0 ]; do
  [ ! -e /run/tvheadend-stop-request ] && [ ! -e /run/nexus-tuner-shutdown ] || break
  sleep 1
  delay=$((delay-1))
 done
done
echo STOPPED > /run/tvheadend-status
finish
